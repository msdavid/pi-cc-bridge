{
  "name": "pi-cc-bridge",
  "version": "0.2.0",
  "description": "Bridge pi-intercom sessions and Claude Code cross-session messaging: pi sessions and Claude Code sessions appear as peers to each other.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi-intercom",
    "claude-code",
    "cross-session-messaging",
    "bridge"
  ],
  "files": [
    "extensions",
    "src",
    "bin",
    "claude-plugin",
    "docs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "bin": {
    "pi-cc-bridge": "./bin/pi-cc-bridge.mjs"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/holder.ts --bundle --platform=node --format=esm --outfile=dist/holder.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "tsx": "^4.20.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24",
    "typescript": "^5",
    "esbuild": "^0.27"
  },
  "author": {
    "name": "mauro"
  },
  "engines": {
    "node": ">=20"
  }
}
