{
  "name": "pi-cc-bridge",
  "version": "0.3.0",
  "description": "Session-to-session messaging between pi coding-agent and Claude Code: your pi sessions appear in Claude Code /list-agents and your Claude Code sessions appear in pi's intercom list. Multi-agent coordination across both tools \u2014 coordinators, supervisors, subagents \u2014 via pi-intercom and the Claude Code cross-session protocol. No modifications to either tool.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi-intercom",
    "claude-code",
    "cross-session-messaging",
    "multi-agent",
    "agent-orchestration",
    "coordinators",
    "supervisors",
    "subagents",
    "agent-teams",
    "intercom",
    "sessions",
    "bridge",
    "claude",
    "interoperability",
    "coding-agent",
    "anthropic",
    "automation"
  ],
  "files": [
    "extensions",
    "src",
    "bin",
    "dist",
    "claude-plugin",
    "docs",
    "snippets",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "./docs/screenshots/cc-list-agents.png"
  },
  "bin": {
    "pi-cc-bridge": "./bin/pi-cc-bridge.mjs"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.mjs && esbuild src/holder.ts --bundle --platform=node --format=esm --outfile=dist/holder.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24",
    "typescript": "^5",
    "esbuild": "^0.27",
    "tsx": "^4.20.0"
  },
  "author": {
    "name": "mauro"
  },
  "engines": {
    "node": ">=20.6"
  },
  "os": [
    "linux"
  ]
}
